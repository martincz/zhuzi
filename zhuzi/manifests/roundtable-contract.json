{
  "schema_version": 3,
  "references": {
    "workflow": "zhuzi/workflows/roundtable.md",
    "seat_registry": "zhuzi/references/seat-registry.md",
    "verdict_schema": "zhuzi/references/verdict-schema.md",
    "quick_template": "zhuzi/templates/roundtable-quick.md",
    "quick_example": "examples/roundtable-quick.md",
    "verdict_json_schema": "zhuzi/schemas/verdict.schema.json"
  },
  "quick_output": {
    "headings": [
      "## 主持人结论",
      "## 议题卡",
      "## 席位短评",
      "## 做完会怎样",
      "## 决策表",
      "## 下一步"
    ],
    "decision_categories": [
      "locked",
      "deferred",
      "discretion"
    ]
  },
  "dispatch_rules": {
    "min_invoked_seats": 1,
    "auto_short_circuit_on_single_seat": true,
    "short_circuit_override_phrases": [
      "强制开圆桌",
      "force roundtable"
    ],
    "review_seat_soft_count": 3,
    "review_seat_soft_count_semantics": "soft hint, not a hard cap; 所有命中席位均审议，按运行时并发容量排队，不截掉席位",
    "scheduling": "bounded_parallel"
  },
  "verdict_schema": {
    "layers": [
      "core",
      "must_haves_review",
      "must_haves_challenge",
      "seat_specific"
    ],
    "route_space": [
      "go",
      "go_with_conditions",
      "revise_must_haves",
      "kill",
      "too_hard"
    ],
    "review_flags": [
      "none",
      "threshold_issue",
      "method_issue",
      "overfitting_risk",
      "metric_gaming",
      "coverage_gap",
      "lookahead_unchecked",
      "multiple_testing",
      "incentive_mismatch",
      "other"
    ],
    "core_fields": {
      "confidence": {
        "type": "string",
        "enum": [
          "low",
          "medium",
          "high"
        ],
        "description": "证据支持程度，与席位是否一致分开"
      },
      "hard_blockers": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "description": "转 go 前必须解决的条件"
      },
      "peer_disagreements": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "peer",
            "point"
          ],
          "properties": {
            "peer": {
              "type": "string",
              "minLength": 1
            },
            "point": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "description": "见过对方原文后记录的分歧；盲审首轮为空"
      },
      "evidence": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "claim",
            "source",
            "kind"
          ],
          "properties": {
            "claim": {
              "type": "string",
              "minLength": 1
            },
            "source": {
              "type": "string",
              "minLength": 1
            },
            "kind": {
              "type": "string",
              "enum": [
                "provided",
                "observed",
                "primary_source",
                "inference"
              ]
            }
          },
          "additionalProperties": false
        },
        "description": "每项含 claim/source/kind 的可追溯依据"
      },
      "missing_evidence": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "description": "尚缺的关键资料或未核实的前提"
      }
    },
    "review_item": {
      "type": "object",
      "required": [
        "truth",
        "flag"
      ],
      "properties": {
        "truth": {
          "type": "integer",
          "minimum": 1
        },
        "flag": {
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "proposed_criterion": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "challenge": {
      "type": "object",
      "required": [
        "triggered",
        "challenged_truths",
        "fundamental_issue",
        "proposed_revision"
      ],
      "properties": {
        "triggered": {
          "type": "boolean"
        },
        "challenged_truths": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "uniqueItems": true
        },
        "fundamental_issue": {
          "type": "string"
        },
        "proposed_revision": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "truth_id",
              "revised_truth",
              "revised_verify_suggestion",
              "spawn_sub_topic"
            ],
            "properties": {
              "truth_id": {
                "type": "integer",
                "minimum": 1
              },
              "revised_truth": {
                "type": "string",
                "minLength": 1,
                "maxLength": 50
              },
              "revised_verify_suggestion": {
                "type": "string"
              },
              "spawn_sub_topic": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "seats": {
    "taleb-reviewer": {
      "skill": "taleb-antifragile",
      "agent": "taleb-reviewer",
      "core_seat": "taleb",
      "persona": "Taleb",
      "generated_block": "taleb_output_contract",
      "registry_summary": {
        "seat": "风险结构",
        "role": "尾部风险、fragility、凸性、barbell、skin in the game",
        "default_stages": "[1]",
        "domains": "不确定性 / 尾部风险 / 脆弱性 / 凸性 / ruin risk / barbell / 冗余 / 选择权 / 依赖链风险 / skin-in-the-game / 厚尾分布"
      },
      "stage_policy": {
        "strategy_business_org": {
          "mode": "conditional",
          "stages": [
            1
          ],
          "condition": "含不确定性 / 尾部 / 脆弱性"
        },
        "research_eval": {
          "mode": "conditional",
          "stages": [
            1
          ],
          "condition": "仅在评估暴露尾部风险时"
        },
        "pure_code_implementation": {
          "mode": "never",
          "stages": []
        },
        "engineering_decision": {
          "mode": "conditional",
          "stages": [
            1
          ],
          "condition": "仅在工程方案有系统性脆弱性时"
        },
        "hybrid": {
          "mode": "always",
          "stages": [
            1
          ]
        }
      },
      "registry_stage_row": {
        "seat": "Taleb",
        "strategy_business_org": "含不确定性 / 尾部 / 脆弱性 → `[1]`",
        "research_eval": "仅在评估暴露尾部风险时 `[1]`",
        "pure_code_implementation": "弃权",
        "engineering_decision": "仅在工程方案有系统性脆弱性时 `[1]`",
        "hybrid": "[1]"
      },
      "shared_root_keys": [
        "taleb_verdict"
      ],
      "native_verdict_routes": {
        "fragile": [
          "go_with_conditions",
          "revise_must_haves",
          "kill"
        ],
        "robust": [
          "go"
        ],
        "antifragile": [
          "go"
        ]
      },
      "output_contract": {
        "shared_intro": "共享四层 schema 的字段含义以 [verdict 字段说明](../references/verdict-schema.md) 为准；Taleb 只补自己独有的 root key、native verdict 和 `seat_specific` 约束。",
        "sections": [
          {
            "root_key": "taleb_verdict",
            "phase": "1",
            "must_haves_review_note": "`must_haves_review` 必须逐条 truth 给记录，即使 `flag: none`",
            "must_haves_challenge_note": "`must_haves_challenge.triggered: true` 代表 must_haves 本身把 Mediocristan 指标拿去审 Extremistan 问题，或根本忽视了 ruin / Jensen / time-average 约束",
            "field_schemas": {
              "tail_events_breaking_must_haves": {
                "type": "array"
              },
              "fragility_checklist_failures": {
                "type": "array"
              },
              "distribution_class": {
                "type": "string",
                "enum": [
                  "mediocristan",
                  "extremistan",
                  "unclear"
                ]
              },
              "payoff_convexity": {
                "type": "string",
                "enum": [
                  "concave",
                  "linear",
                  "convex",
                  "unclear"
                ]
              },
              "skin_in_the_game": {
                "type": "string",
                "enum": [
                  "yes",
                  "no",
                  "partial"
                ]
              }
            }
          }
        ]
      },
      "required_contract_snippets": [
        "## 审议动作"
      ],
      "adapter": {
        "description": "仅由诸子圆桌或短读协调器按名调用的风险结构只读评议席；常规任务不调用，单人物视角用 $zhuzi taleb 或 /zhuzi taleb。",
        "color": "orange",
        "mode": "readonly"
      }
    },
    "munger-reviewer": {
      "skill": "munger-checklist",
      "agent": "munger-reviewer",
      "core_seat": "munger",
      "persona": "Munger",
      "generated_block": "munger_output_contract",
      "registry_summary": {
        "seat": "决策质量",
        "role": "愚蠢清单、认知偏误、激励结构、能力圈、机会成本",
