        "strategy_business_org": "含判断质量 / 激励 / 能力圈 / 机会成本 → `[1]`",
        "research_eval": "仅在指标激励或研究者偏误关键时 `[1]`",
        "pure_code_implementation": "弃权",
        "engineering_decision": "弃权",
        "hybrid": "[1]"
      },
      "shared_root_keys": [
        "munger_verdict"
